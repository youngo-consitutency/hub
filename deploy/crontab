# Install on the server with: crontab deploy/crontab   (edit the path and domain first)
# Mail the output of failed runs to someone who will read it: set MAILTO.
MAILTO=
DEPLOY=/opt/youngo-hub/deploy

# the two jobs vercel.json schedules on Vercel
0 6 * * *  . $DEPLOY/.env && curl -fsS -H "Authorization: Bearer $CRON_SECRET" "https://$HUB_DOMAIN/api/cron/notifications-drain" >/dev/null
30 6 * * * . $DEPLOY/.env && curl -fsS -H "Authorization: Bearer $CRON_SECRET" "https://$HUB_DOMAIN/api/cron/decisions-sweep" >/dev/null

# encrypted off-site database backup
15 3 * * * $DEPLOY/backup.sh
