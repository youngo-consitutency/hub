# Copy to .env on the server (chmod 600). Never commit the real file.

# the public address, without a path
HUB_DOMAIN=hub.example.org
APP_BASE_URL=https://hub.example.org
NEXT_PUBLIC_APP_BASE_URL=https://hub.example.org

# the images built by CI (see .github/workflows/publish-image.yml)
HUB_IMAGE=ghcr.io/youngo-consitutency/hub
HUB_TAG=latest

# generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
PAYLOAD_SECRET=
CRON_SECRET=

# email (any SMTP provider), see the wiki for Brevo or Amazon SES settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hub@hub.example.org

# web push keys: node scripts/setup/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hub@hub.example.org

# optional
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# backups (deploy/backup.sh): an age public key and an S3-compatible bucket (Cloudflare R2)
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=r2:youngo-hub-backups
BACKUP_KEEP_DAYS=30
