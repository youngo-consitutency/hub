{
  "name": "youngo-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev-all": "concurrently \"node server/index.js 8787\" \"npm run dev\"",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node scripts/database/migrate.js",
    "bootstrap-admin": "node scripts/admin/bootstrap-admin.js",
    "content:check": "node scripts/content/check-content.js",
    "format": "prettier --write \"{.github,src,server,shared,scripts,tests,public}/**/*.{js,jsx,mjs,css,json,yml,yaml}\" \"*.{js,json,yml,yaml}\"",
    "format:check": "prettier --check \"{.github,src,server,shared,scripts,tests,public}/**/*.{js,jsx,mjs,css,json,yml,yaml}\" \"*.{js,json,yml,yaml}\"",
    "screenshots": "node scripts/docs/capture-readme-screenshots.mjs",
    "setup:push": "node scripts/setup/generate-vapid-keys.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run content:check && npm run format:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "libphonenumber-js": "1.13.9",
    "lucide-react": "^1.8.0",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "playwright": "^1.62.0",
    "prettier": "3.9.6",
    "vite": "^8.0.0"
  }
}
