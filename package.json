{
  "name": "youngo-hub",
  "version": "1.0.0",
  "description": "YOUNGO Hub — member platform and mission control (Next.js + Payload CMS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "check": "npm run lint && npm run build",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "mcp:hub": "node scripts/agent/hub-mcp.mjs",
    "mcp:content:http": "node mcp-content/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:mcp": "node scripts/agent/sync-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/email-nodemailer": "^3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@sentry/nextjs": "^11.0.0",
    "calendar-link": "^2.11.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "downshift": "^9.4.0",
    "file-type": "^22.1.1",
    "ical-generator": "^11.1.1",
    "libphonenumber-js": "^1.13.14",
    "next": "^16.4.0",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.7.0",
    "payload": "3.90.2",
    "pg": "8.23.0",
    "rate-limiter-flexible": "^11.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sentry/core": "11.1.0",
    "@types/node": "26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.6",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "@payloadcms/email-nodemailer": {
      "nodemailer": "10.0.12"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "sass": "1.105.1"
  }
}
