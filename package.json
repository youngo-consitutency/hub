{
  "name": "youngo-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --import tsx server/index.js",
    "dev-all": "concurrently \"node --import tsx server/index.js 8787\" \"npm run dev\"",
    "build": "vite build",
    "start": "node --import tsx server/index.js",
    "worker": "node --import tsx server/worker.js",
    "migrate": "node scripts/database/migrate.js",
    "bootstrap-admin": "node scripts/admin/bootstrap-admin.js",
    "seed-demo-accounts": "node scripts/admin/seed-demo-accounts.js",
    "seed-mandate-accounts": "node scripts/admin/seed-mandate-accounts.js",
    "seed-cp-calls": "node scripts/admin/seed-cp-calls.js",
    "content:check": "node scripts/content/check-content.js",
    "format": "prettier --write \"{.github,api,src,server,shared,scripts,tests,public,mcp-content}/**/*.{js,jsx,mjs,ts,tsx,css,json,yml,yaml}\" \"*.{js,json,yml,yaml}\"",
    "format:check": "prettier --check \"{.github,api,src,server,shared,scripts,tests,public,mcp-content}/**/*.{js,jsx,mjs,ts,tsx,css,json,yml,yaml}\" \"*.{js,json,yml,yaml}\"",
    "setup:push": "node scripts/setup/generate-vapid-keys.mjs",
    "mcp:content": "node scripts/agent/hub-content-mcp.mjs",
    "mcp:content:http": "node mcp-content/server.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run content:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "bootstrap-membership-steward": "node scripts/admin/bootstrap-membership-steward.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.13.11",
    "mjml": "^5.4.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
