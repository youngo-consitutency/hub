# YOUNGO Hub environment template — copy to .env.local for local development.
# Never commit real values. Hosted secrets live in Vercel/GitHub/Neon stores.

# --- Core ---
# PostgreSQL (pooled Neon URL on hosted envs, local postgres for dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/youngo_dev
# Required by Payload — any long random string for local dev
PAYLOAD_SECRET=
# Canonical origin for absolute links (emails, redirects). On Vercel previews
# the code falls back to VERCEL_BRANCH_URL/VERCEL_URL automatically.
APP_BASE_URL=http://localhost:3000
# Optional SPA-side fallback for absolute links (window.location wins in browsers)
# NEXT_PUBLIC_APP_BASE_URL=

# --- Email delivery (optional — outbox stays pending without SMTP) ---
# SMTP_URL= smtps://user:pass@host:465  (or the discrete settings below)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# Comma-separated recipient allowlist — keeps test/demos from emailing real people
# EMAIL_RECIPIENT_ALLOWLIST=
# Signs unsubscribe links and authenticates inbound webhooks
# EMAIL_UNSUBSCRIBE_SECRET=
# EMAIL_WEBHOOK_SECRET=

# --- Web push (optional) ---
# Generate with: node scripts/setup/generate-vapid-keys.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hub@your-domain.tld

# --- Observability (optional — Sentry is inert without a DSN) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Cron ---
# Bearer secret for the notification-drain cron endpoint
# CRON_SECRET=

# --- Demo mode ---
# Suppresses outbound delivery and shows demo banners
# HUB_DEMO_MODE=
# NEXT_PUBLIC_HUB_DEMO=

# --- MCP content service ---
# HUB_ORIGIN=http://localhost:3000
# HUB_EMAIL=              member account (or HUB_TOKEN)
# HUB_PASSWORD=
# HUB_TOKEN=
# MCP_TOKEN=              transport auth for the HTTP server
# MCP_ALLOW_ANONYMOUS=    1 only for connectors that cannot send auth
# PORT=8080

# --- Local seed/bootstrap ---
# CONSOLE_EMAIL=          first staff account for `npm run seed`
# CONSOLE_PASSWORD=

# --- Test-only overrides (never set on deployed environments) ---
# HUB_DISABLE_RATE_LIMIT=1
# TEST_BASE_URL=
