# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/youngo_dev
PAYLOAD_SECRET=change-me-long-random-string

# Canonical origin for absolute links in emails/redirects.
# Optional on Vercel: falls back to VERCEL_BRANCH_URL/VERCEL_URL, then localhost.
# APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Email delivery (sender defaults to hub@<APP_BASE_URL host>)
# SMTP_URL=                    # single connection URL, wins over SMTP_HOST
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=
# EMAIL_UNSUBSCRIBE_SECRET=
# EMAIL_WEBHOOK_SECRET=
# Comma-separated allowlist for non-production sends
# EMAIL_RECIPIENT_ALLOWLIST=

# Web push (scripts/setup/generate-vapid-keys.mjs creates a pair)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org

# Sentry
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Behaviour toggles
# HUB_DELIVERY_DISABLED=true    # no email, push or agent keys (always off on Vercel previews)
# HUB_DISABLE_RATE_LIMIT=1      # local/test servers only
# CRON_SECRET=                  # shared secret for scheduled routes
# STANDALONE_BUILD=1            # Docker build only: next.config.ts output 'standalone'

# Operators and feedback mirroring
# YOUNGO_OPERATOR_ACCOUNT_IDS=  # comma-separated account ids that count as operators for agent keys
# GITHUB_ISSUE_TOKEN=           # token that mirrors feedback to GitHub issues (off unless repo is set too)
# GITHUB_ISSUE_REPO=            # owner/repo that receives mirrored issues

# Content MCP service (separate process — never give it DATABASE_URL)
# PORT=8080
# MCP_TOKEN=                    # required; sent as Authorization: Bearer
# MCP_ALLOWED_ORIGINS=          # comma-separated browser origins that get CORS headers
# HUB_ORIGIN=http://localhost:3000

# Agent gateway connector service (mcp-youngo, separate process)
# HUB_AGENT_GATEWAY_TOKEN=      # service token shared by the Hub and mcp-youngo
# YOUNGO_MCP_PUBLIC_URL=        # public URL of mcp-youngo shown to members when they mint a key
# YOUNGO_MCP_ORIGINS=           # comma-separated browser origins that get CORS headers on mcp-youngo

# Agent credentials for the stdio MCP client (scripts/agent/hub-mcp.mjs)
# HUB_EMAIL=
# HUB_PASSWORD=
# HUB_TOKEN=

# Agent session memory (Hindsight bank `youngo-hub`) — attaches memory tools
# to the `hub` server. Ask a maintainer for the key, then run `npm run
# sync:mcp` to write every tool's local MCP config.
# HINDSIGHT_API_KEY=

# One-off scripts and tests (never set these on a deployed environment)
# TEST_BASE_URL=http://localhost:3000   # server the integration tests and scripts/ci/smoke.ts call
# MCP_SMOKE_PORT=18080                  # port for scripts/ci/mcp-smoke.mjs
# LEGACY_DATABASE_URL=          # scripts/setup/import-legacy-members.ts: the old Hub's database
# LEGACY_COY_SLUG=coy21         # COY the legacy allowlist maps to
# LEGACY_DIR=                   # scripts/setup/import-legacy-content.ts: checkout of the old repo
# ACCOUNT_ID= ROLE= SCOPE_TYPE= SCOPE_ID=   # per-run inputs to scripts/setup/grant-authority.ts (see AGENTS.md)
