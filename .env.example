# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/youngo_dev
PAYLOAD_SECRET=change-me-long-random-string

# Canonical origin for absolute links in emails/redirects.
# Optional on Vercel: falls back to VERCEL_BRANCH_URL/VERCEL_URL, then localhost.
# APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Email delivery (sender defaults to hub@<APP_BASE_URL host>)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=
# EMAIL_UNSUBSCRIBE_SECRET=
# EMAIL_WEBHOOK_SECRET=
# Comma-separated allowlist for non-production sends
# EMAIL_RECIPIENT_ALLOWLIST=

# Web push (scripts/setup/generate-vapid-keys.mjs creates a pair)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org

# Sentry
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Behaviour toggles
# NEXT_PUBLIC_HUB_DEMO=1        # demo banner + noindex (HUB_DEMO_MODE is the server alias)
# HUB_DISABLE_RATE_LIMIT=1      # local/test servers only
# CRON_SECRET=                  # shared secret for scheduled routes

# Content MCP service (separate process — never give it DATABASE_URL)
# PORT=8080
# MCP_TOKEN=
# MCP_ALLOW_ANONYMOUS=0
# HUB_ORIGIN=http://localhost:3000

# Agent credentials for the stdio MCP client (scripts/agent/hub-mcp.mjs)
# HUB_EMAIL=
# HUB_PASSWORD=
# HUB_TOKEN=

# Agent session memory (Hindsight bank `youngo-hub`) — attaches memory tools
# to the `hub` server. Ask a maintainer for the key, then run `npm run
# sync:mcp` to write every tool's local MCP config.
# HINDSIGHT_API_KEY=
