{
  "mcpServers": {
    "youngo-hub-tickets": {
      "command": "node",
      "args": ["${workspaceFolder}/scripts/agent/hub-tickets-mcp.mjs"],
      "env": {
        "HUB_AGENT_RO_URL": "${env:HUB_AGENT_RO_URL}"
      }
    },
    "youngo-hub-content": {
      "command": "node",
      "args": ["${workspaceFolder}/scripts/agent/hub-content-mcp.mjs"],
      "env": {
        "HUB_ORIGIN": "https://youngohub.org",
        "HUB_EMAIL": "${env:HUB_EMAIL}",
        "HUB_PASSWORD": "${env:HUB_PASSWORD}"
      }
    }
  }
}
